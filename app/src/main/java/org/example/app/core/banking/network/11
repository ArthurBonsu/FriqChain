## Dependency Configuration

### Step 5: Create NetworkModule.java

Create a centralized initialization class:

```java
// core/banking/network/NetworkModule.java

package org.example.app.core.banking.network;

import org.example.app.core.p2p.CrossShardRelay;
import org.example.app.core.p2p.PeerNetwork;

import java.util.logging.Logger;

public class NetworkModule {
    private static final Logger logger = Logger.getLogger(NetworkModule.class.getName());
    
    // Core components
    private final ShardCoordinator shardCoordinator;
    private final PasschainManager passchainManager;
    private final RelayChainProtocol relayProtocol;
    private final LoadBalancer loadBalancer;
    private final RegionalNodeCluster nodeCluster;
    
    // Financial components
    private final DecentralizedFXMatcher fxMatcher;
    private final LiquidityPoolRegistry poolRegistry;
    private final CrossBorderBridge crossBorderBridge;
    
    // External integration
    private final InteroperabilityProtocol interopProtocol;
    
    public NetworkModule(CrossShardRelay crossShardRelay) {
        logger.info("Initializing NetworkModule...");
        
        // Initialize core components
        this.shardCoordinator = new ShardCoordinator();
        this.passchainManager = new PasschainManager();
        this.relayProtocol = new RelayChainProtocol(crossShardRelay);
        this.loadBalancer = new LoadBalancer(shardCoordinator);
        this.nodeCluster = new RegionalNodeCluster();
        
        // Initialize financial components
        this.fxMatcher = new DecentralizedFXMatcher();
        this.poolRegistry = new LiquidityPoolRegistry();
        this.crossBorderBridge = new CrossBorderBridge(
            fxMatcher, poolRegistry, relayProtocol
        );
        
        // Initialize external integration
        this.interopProtocol = new InteroperabilityProtocol();
        
        logger.info("NetworkModule initialized successfully");
    }
    
    public void start() {
        logger.info("Starting NetworkModule services...");
        
        // Start shard management
        shardCoordinator.initializeGeographicShards();
        shardCoordinator.startHealthMonitoring();
        shardCoordinator.startAutoRebalancing();
        
        // Start passchain checkpointing
        passchainManager.startCheckpointing();
        
        // Start relay protocol
        relayProtocol.startTimeoutChecker();
        
        // Start load balancer
        loadBalancer.initializeShardLoads();
        loadBalancer.startAutoRebalancing();
        
        // Start node cluster monitoring
        nodeCluster.startHealthMonitoring();
        
        // Start FX rate calculation
        fxMatcher.startRateCalculation();
        
        // Start cross-border bridge
        crossBorderBridge.startTimeoutChecker();
        
        logger.info("NetworkModule services started");
    }
    
    public void shutdown() {
        logger.info("Shutting down NetworkModule...");
        
        shardCoordinator.shutdown();
        passchainManager.shutdown();
        relayProtocol.shutdown();
        loadBalancer.shutdown();
        nodeCluster.shutdown();
        fxMatcher.shutdown();
        crossBorderBridge.shutdown();
        interopProtocol.shutdown();
        
        logger.info("NetworkModule shutdown complete");
    }
    
    // Getters
    public ShardCoordinator getShardCoordinator() { return shardCoordinator; }
    public PasschainManager getPasschainManager() { return passchainManager; }
    public RelayChainProtocol getRelayProtocol() { return relayProtocol; }
    public LoadBalancer getLoadBalancer() { return loadBalancer; }
    public RegionalNodeCluster getNodeCluster() { return nodeCluster; }
    public DecentralizedFXMatcher getFxMatcher() { return fxMatcher; }
    public LiquidityPoolRegistry getPoolRegistry() { return poolRegistry; }
    public CrossBorderBridge getCrossBorderBridge() { return crossBorderBridge; }
    public InteroperabilityProtocol getInteropProtocol() { return interopProtocol; }
}
```

## Initialization Sequence

### Step 6: Integrate with Main Application

Update your main application class:

```java
// App.java

package org.example.app;

import org.example.app.core.banking.network.NetworkModule;
import org.example.app.core.p2p.CrossShardRelay;
import org.example.app.core.p2p.PeerNetwork;

public class App {
    
    private NetworkModule networkModule;
    
    public static void main(String[] args) {
        App app = new App();
        app.initialize();
        app.start();
        
        // Add shutdown hook
        Runtime.getRuntime().addShutdownHook(new Thread(() -> {
            System.out.println("Shutting down gracefully...");
            app.shutdown();
        }));
    }
    
    public void initialize() {
        System.out.println("Initializing TINC Blockchain...");
        
        // Initialize CrossShardRelay (required dependency)
        CrossShardRelay crossShardRelay = new CrossShardRelay();
        
        // Initialize network module
        networkModule = new NetworkModule(crossShardRelay);
        
        System.out.println("TINC Blockchain initialized");
    }
    
    public void start() {
        System.out.println("Starting TINC Blockchain services...");
        
        // Start network module
        networkModule.start();
        
        // Register initial validators, exchanges, etc.
        bootstrapNetwork();
        
        System.out.println("TINC Blockchain running");
    }
    
    private void bootstrapNetwork() {
        // Register relay validators
        networkModule.getRelayProtocol()
            .registerValidator("validator-1", "pubkey1");
        
        // Register African exchanges
        networkModule.getFxMatcher().registerExchange(
            "lagos-stock-exchange",
            "Lagos Stock Exchange",
            DecentralizedFXMatcher.SourceType.AFRICAN_EXCHANGE
        );
        
        // Create initial liquidity pools
        networkModule.getPoolRegistry()
            .createPool("NGN-TOKEN", "ASU-TOKEN", true);
        
        // Register nodes in regions
        networkModule.getNodeCluster()
            .registerNode("node-1", "192.168.1.100", "WEST_AFRICA");
    }
    
    public void shutdown() {
        if (networkModule != null) {
            networkModule.shutdown();
        }
    }
}
```

## Configuration

### Step 7: Create Configuration File

Create `network-config.properties`:

```properties
# network-config.properties

# Shard Configuration
shard.target.count=20
shard.max.count=50
shard.target.tps=5000
shard.max.region.control=0.33

# Load Balancing
loadbalancer.strategy=HYBRID
loadbalancer.target.utilization=0.75
loadbalancer.max.utilization=0.90

# Fair Rate Algorithm
fairrate.african.exchange.weight=1.55
fairrate.global.exchange.weight=1.0
fairrate.min.sources=3
fairrate.zscore.threshold=3.0

# Cross-Border Settlements
crossborder.intra.african.fee=0.001
crossborder.external.fee=0.005
crossborder.settlement.timeout=300000

# Regional Distribution
regions=WEST_AFRICA,EAST_AFRICA,CENTRAL_AFRICA,SOUTHERN_AFRICA,NORTH_AFRICA
region.min.nodes=3

# Relay Chain
relay.min.validators=5
relay.message.timeout=30000
```

