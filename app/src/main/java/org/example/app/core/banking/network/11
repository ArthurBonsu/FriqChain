### Step 9: Integration Testing

Create integration test:

```java
// NetworkModuleIntegrationTest.java

import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeAll;
import org.junit.jupiter.api.AfterAll;

public class NetworkModuleIntegrationTest {
    
    private static NetworkModule networkModule;
    
    @BeforeAll
    public static void setup() {
        CrossShardRelay relay = new CrossShardRelay();
        networkModule = new NetworkModule(relay);
        networkModule.start();
    }
    
    @Test
    public void testShardCoordination() {
        assertEquals(20, networkModule.getShardCoordinator().getShardCount());
    }
    
    @Test
    public void testCrossBorderSettlement() {
        String settlementId = networkModule.getCrossBorderBridge()
            .initiateSettlement("NGN", "GHS", fromAddr, toAddr, 
                amount, "NGN", "GHS");
        
        assertNotNull(settlementId);
    }
    
    @AfterAll
    public static void teardown() {
        networkModule.shutdown();
    }
}
```

## Deployment

### Step 10: Production Deployment

#### 1. Build Production JAR
```bash
./gradlew clean build -x test
```

#### 2. Create Deployment Package
```bash
mkdir deployment
cp build/libs/tinc-blockchain.jar deployment/
cp network-config.properties deployment/
```

#### 3. Deploy to Server
```bash
# Upload to server
scp deployment/* user@server:/opt/tinc/

# SSH to server
ssh user@server

# Run application
cd /opt/tinc
java -Xmx8G -jar tinc-blockchain.jar
```

#### 4. Monitor Logs
```bash
tail -f /var/log/tinc/network-module.log
```

